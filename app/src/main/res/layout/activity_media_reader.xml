<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?android:colorBackground">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="0dp"
		android:layout_height="?attr/actionBarSize"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<com.google.android.material.progressindicator.LinearProgressIndicator
		android:id="@+id/progress"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:indeterminate="true"
		android:visibility="gone"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/toolbar" />

	<WebView
		android:id="@+id/web_view"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:visibility="gone"
		app:layout_constraintBottom_toTopOf="@id/chapter_controls"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/progress" />

	<androidx.media3.ui.PlayerView
		android:id="@+id/player_view"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:keepScreenOn="true"
		android:visibility="gone"
		app:layout_constraintBottom_toTopOf="@id/chapter_controls"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/progress"
		app:show_buffering="when_playing"
		app:use_controller="true" />

	<LinearLayout
		android:id="@+id/chapter_controls"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="12dp"
		android:paddingTop="6dp"
		android:paddingBottom="10dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent">

		<TextView
			android:id="@+id/chapter_status"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:maxLines="1"
			android:paddingBottom="4dp"
			android:text="@string/loading_"
			android:textAppearance="?attr/textAppearanceLabelMedium" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_previous"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:contentDescription="@string/prev_chapter"
				android:minWidth="0dp"
				android:text="@string/media_reader_previous_short" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_text_smaller"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:layout_weight="1"
				android:contentDescription="@string/media_reader_decrease_text"
				android:minWidth="0dp"
				android:text="@string/media_reader_decrease_text_short"
				android:visibility="gone" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_text_larger"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:layout_weight="1"
				android:contentDescription="@string/media_reader_increase_text"
				android:minWidth="0dp"
				android:text="@string/media_reader_increase_text_short"
				android:visibility="gone" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_next"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:layout_weight="1"
				android:contentDescription="@string/next_chapter"
				android:minWidth="0dp"
				android:text="@string/media_reader_next_short" />

		</LinearLayout>
	</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
